# Environment configuration template.
# Copy to .env, .env.development, .env.staging or .env.production and fill in the values.
# The active file is selected with APP_ENVIRONMENT (see scripts/build/*).

# Environment identifier (development, staging, production)
APP_ENV=development

# API
API_BASE_URL=https://your-api-url.com
SOCKET_URL=https://your-socket-url.com

# App identifiers
ANDROID_APP_ID=com.yourapp.android
IOS_APP_ID=com.yourapp.ios
